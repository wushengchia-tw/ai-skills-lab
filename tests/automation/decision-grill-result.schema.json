{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision-Grill semantic judge result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "result", "confidence", "satisfied_conditions", "violated_conditions", "evidence", "review_required", "reason"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^DG-[0-9]{3}$" },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "satisfied_conditions": { "type": "array", "items": { "type": "string" } },
    "violated_conditions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "review_required": { "type": "boolean" },
    "reason": { "type": "string" }
  }
}
